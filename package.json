{
  "name": "figma-token-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:plugin": "esbuild plugin/src/code.ts --bundle --target=es2017 --outfile=plugin/dist/code.js && cp plugin/src/ui.html plugin/dist/ui.html",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/index.js",
    "build": "npm run build:plugin && npm run build:server",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
